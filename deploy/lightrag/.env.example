# SkillForge LightRAG stack
# Copy to .env and fill secrets locally. Do not commit .env.

LIGHTRAG_BIND_HOST=127.0.0.1
LIGHTRAG_HOST_PORT=19621
DOCLING_BIND_HOST=127.0.0.1
DOCLING_HOST_PORT=15001

# Image source. Defaults are official GHCR images. For China mainland hosts,
# uncomment the m.daocloud.io mirrors or use your own registry mirror.
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:latest
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu:latest
# LIGHTRAG_IMAGE=m.daocloud.io/ghcr.io/hkuds/lightrag:latest
# DOCLING_IMAGE=m.daocloud.io/ghcr.io/docling-project/docling-serve-cpu:latest

# Optional LightRAG API auth. If set, also configure
# knowledge.lightrag.api_key in SkillForge admin settings.
LIGHTRAG_API_KEY=
LIGHTRAG_API_KEYS=

# LLM used by LightRAG text generation.
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_BINDING_HOST=
LIGHTRAG_LLM_BINDING_API_KEY=
LIGHTRAG_LLM_MODEL=

# Embedding model used by LightRAG server-side indexing/retrieval.
LIGHTRAG_EMBEDDING_BINDING=openai
LIGHTRAG_EMBEDDING_BINDING_HOST=
LIGHTRAG_EMBEDDING_BINDING_API_KEY=
LIGHTRAG_EMBEDDING_MODEL=
LIGHTRAG_EMBEDDING_DIM=1024

# Optional reranker.
LIGHTRAG_RERANK_BINDING=null
LIGHTRAG_RERANK_MODEL=
LIGHTRAG_RERANK_BINDING_HOST=
LIGHTRAG_RERANK_BINDING_API_KEY=

# Multimodal parsing. SkillForge stores the corresponding admin-visible
# connection and model settings in system_config for health checks.
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=
VLM_LLM_BINDING_API_KEY=
VLM_LLM_MODEL=
LIGHTRAG_PARSER=*:docling-iteP,*:native-teP,*:legacy-R
DOCLING_ENDPOINT=http://docling:5001
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=true
DOCLING_DO_FORMULA_ENRICHMENT=false

# Storage defaults keep a single-host deployment simple.
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
