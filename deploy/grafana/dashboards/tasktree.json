{
  "uid": "tasktree-overview",
  "title": "TaskTree Overview",
  "tags": ["tasktree", "skillforge"],
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "department",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(tasktree_active_roots, department)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Writer Failure Rate (per source)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(tasktree_writer_failure_total[5m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Repair Queue Size (current)",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {"expr": "tasktree_repair_queue_size", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Repair Queue Size & Lag (trend)",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "lag_seconds"},
            "properties": [{"id": "unit", "value": "s"}]
          }
        ]
      },
      "targets": [
        {"expr": "tasktree_repair_queue_size", "legendFormat": "queue_size", "refId": "A"},
        {"expr": "tasktree_repair_lag_seconds", "legendFormat": "lag_seconds", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Drift Count",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "tasktree_drift_count", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "get_task_tree Latency (P50 / P95 / P99)",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(tasktree_get_tree_p99_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tasktree_get_tree_p99_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(tasktree_get_tree_p99_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI Diagnose Success Rate",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1}
      },
      "targets": [
        {
          "expr": "1 - ai_diagnose_failure_rate",
          "legendFormat": "success_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Active Roots by Department",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": {"displayMode": "hidden", "placement": "bottom"}
      },
      "targets": [
        {
          "expr": "tasktree_active_roots{department=~\"$department\"}",
          "legendFormat": "{{department}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cache Hit Rate (rolling 30m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1}
      },
      "targets": [
        {
          "expr": "sum(rate(tasktree_cache_hits_total[30m])) / (sum(rate(tasktree_cache_hits_total[30m])) + sum(rate(tasktree_cache_misses_total[30m])))",
          "legendFormat": "hit_rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Slow Query Rate (per operation)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0}
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(tasktree_slow_query_total[5m]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TaskTree Request Duration P95 (by endpoint)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tasktree_request_duration_seconds_bucket[15m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "A"
        }
      ]
    }
  ]
}
