# SkillForge 自建 HKUDS LightRAG Server 示例配置
# 用法：cp .env.lightrag.example .env.lightrag，然后按你的模型供应商改值。

# LightRAG 服务
LIGHTRAG_HOST=0.0.0.0
LIGHTRAG_PORT=9621
LIGHTRAG_API_KEY=change-me-lightrag-api-key
LIGHTRAG_WORKSPACE=skillforge

# LLM：OpenAI-compatible。SiliconFlow 示例（不要使用 Pro/* 收费模型）
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BINDING_API_KEY=replace-with-your-siliconflow-key

# Embedding：和后台 ai.embedding.* 保持一致；SiliconFlow BAAI/bge-m3 为 1024 维
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_API_KEY=replace-with-your-siliconflow-key

# 可选：JWT/WebUI 登录等官方镜像变量。如当前镜像版本不识别，会被忽略。
AUTH_ACCOUNTS=admin:change-me-admin-password
TOKEN_SECRET=change-me-token-secret
