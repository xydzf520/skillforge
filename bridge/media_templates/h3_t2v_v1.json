{
  "version": "comfy-official-minimax-h3-t2v-v1",
  "model_version": "MiniMax-H3-fl2va-int8-convrot",
  "upstream": "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/video_minimax_h3_t2v.json",
  "controls": {"create_video_node_id": "13", "save_video_node_id": "14"},
  "bindings": {
    "positive_prompt": [["5", "inputs", "prompt"]],
    "width": [["5", "inputs", "width"]],
    "height": [["5", "inputs", "height"]],
    "frames": [["5", "inputs", "length"]],
    "fps": [["13", "inputs", "fps"]],
    "steps": [["9", "inputs", "steps"]],
    "seed": [["6", "inputs", "noise_seed"]],
    "output_prefix": [["14", "inputs", "filename_prefix"]]
  },
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "5": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["2", 0], "vae": ["3", 0], "prompt": "", "width": 480, "height": 864, "length": 124}},
    "6": {"class_type": "RandomNoise", "inputs": {"noise_seed": 1}},
    "7": {"class_type": "BasicGuider", "inputs": {"model": ["1", 0], "conditioning": ["5", 0]}},
    "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "9": {"class_type": "BasicScheduler", "inputs": {"model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0}},
    "10": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["6", 0], "guider": ["7", 0], "sampler": ["8", 0], "sigmas": ["9", 0], "latent_image": ["5", 1]}},
    "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["3", 0]}},
    "12": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["10", 0], "vae": ["4", 0]}},
    "13": {"class_type": "CreateVideo", "inputs": {"images": ["11", 0], "audio": ["12", 0], "fps": 24.0, "bit_depth": 8}},
    "14": {"class_type": "SaveVideo", "inputs": {"video": ["13", 0], "filename_prefix": "skillforge/h3", "format": "auto", "codec": "auto"}}
  }
}
