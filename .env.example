# ===== 基础配置 =====
APP_NAME=SkillForge
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# ===== 数据库 =====
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=skillforge
DATABASE_URL=postgresql+asyncpg://skillforge:CHANGE_ME_STRONG_PASSWORD@localhost:5432/skillforge
DATABASE_URL_SYNC=postgresql+psycopg2://skillforge:CHANGE_ME_STRONG_PASSWORD@localhost:5432/skillforge
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ===== Git仓库 =====
SKILL_REPO_PATH=./skills-repo
SKILL_REPO_BRANCH=main
# 本地 Docker/Gitea Skill Git 主线；手动同步会先 push 这里，失败则不下发节点
SKILL_REPO_CANONICAL_REMOTE=
# 外部镜像仓库，可选；失败只告警，不阻断节点下发
SKILL_REPO_REMOTE=
GIT_USER_NAME=SkillForge
GIT_USER_EMAIL=skillforge@example.com
GITEA_ROOT_URL=http://localhost:3000/

# ===== 编程 Harness（旧运行时已移除，替代适配器待验收）=====
# 此开关仅兼容旧配置；设为 true 不会恢复旧运行时。
CODING_AGENT_ENABLED=false

# ===== 钉钉配置 =====
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
DINGTALK_CALLBACK_URL=http://localhost:8000/api/dingtalk/callback
DINGTALK_CARD_CALLBACK_URL=http://localhost:8000/api/dingtalk/card-callback
DINGTALK_LOGIN_REDIRECT=http://localhost:8000/api/auth/dingtalk/callback
# Optional business notification recipient; blank disables default routing.
LINK_DECLINE_OPERATOR_RECIPIENT_QUERY=
LINK_DECLINE_OPERATOR_DINGTALK_USER_ID=
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=

# ===== 钉钉审批模板 =====
DINGTALK_APPROVAL_PROCESS_CODE_L2=
DINGTALK_APPROVAL_PROCESS_CODE_L3=

# ===== 监控 =====
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== 浏览器自动化 =====
BROWSER_CDP_HOST=127.0.0.1
BROWSER_CDP_PORT=9222
BROWSER_VERIFY_CDP_HOST=127.0.0.1
BROWSER_VERIFY_CDP_PORT=9224
BROWSER_NOVNC_HOST=127.0.0.1
BROWSER_NOVNC_PORT=6080

# ===== 模型网关（OpenAI 兼容接口，直连 DeepSeek/GLM 等）=====
# 生产密钥不要写入 .env；请在后台系统配置中维护 ai.api_base / ai.model / ai.api_key。
# 以下三项仅作为本地开发兜底。
AI_API_BASE=http://localhost:4000
AI_DEFAULT_MODEL=deepseek-v4-pro
AI_API_KEY=

# ===== Hall · AI Chat（生产请放入服务账号专属的 0600 EnvironmentFile）=====
FASTAITOKEN_BASE_URL=https://www.fastaitoken.com/v1
FASTAITOKEN_DOMESTIC_API_KEY=
FASTAITOKEN_CLAUDE_MAX_API_KEY=
FASTAITOKEN_GPT_PRO_API_KEY=
# 只能填写已经通过真实图片请求验证的模型，逗号分隔；未验证时保持为空。
FASTAITOKEN_VISION_MODELS=
# 必须指向持久卷；已发送图片会随会话永久保留。
SKILLFORGE_AI_CHAT_UPLOAD_DIR=data/ai-chat-assets

# ===== OpenClaw连接 =====
OPENCLAW_DEFAULT_URL=ws://localhost:18789
OPENCLAW_DEFAULT_AUTH=
OPENCLAW_RELOAD_HOOK_URL=localhost:9000
OPENCLAW_RELOAD_TOKEN=
AICLAW_LOCAL_DEFAULT=ws://127.0.0.1:18789

# ===== AIClaw Bridge / 待办 =====
BRIDGE_REQUEST_TIMEOUT_SECONDS=30
AICLAW_CHAT_STREAM_TIMEOUT_SECONDS=120
BRIDGE_PENDING_MAX_PER_CONN=50
BRIDGE_ACTIVE_RUNS_MAX_PER_INSTANCE=20
BRIDGE_CHAT_QUEUE_MAX=200
BRIDGE_REGISTRY_MAX_CONNECTIONS=100
BRIDGE_MAX_FRAME_BYTES=262144
BRIDGE_MAX_ATTACHMENT_BYTES=5242880
BRIDGE_MAX_ATTACHMENTS_TOTAL_BYTES=10485760
BRIDGE_AUTH_NONCE_TTL_SECONDS=30
BRIDGE_PENDING_TTL_SECONDS=60
ENROLLMENT_TOKEN_TTL_MINUTES=30
ENROLLMENT_PEPPER=
COOKIE_ENCRYPT_KEY=
CHAT_SEND_QPS_PER_USER=5
TODO_SLA_HOURS=24
TODO_EXPIRE_LOOP_INTERVAL=300
TRAINING_COLLECT_DUE_ENABLED=true
TRAINING_COLLECT_DUE_INTERVAL=300
TRAINING_COLLECT_DUE_STALE_SECONDS=300
TRAINING_COLLECT_DUE_MAX_JOBS=20
LEARNING_AUTO_TRAINING_MIN_SAMPLES=4

# ===== Bridge 本地训练网关（可选）=====
# 配在 Bridge 运行环境或 env.json 中。未配置时 Bridge 只持久化训练 manifest 作为离线接单兜底。
LOCAL_TRAINING_GATEWAY_URL=
# 示例：LOCAL_TRAINING_GATEWAY_URL=http://127.0.0.1:17890
LOCAL_TRAINING_GATEWAY_TOKEN=
LOCAL_TRAINING_GATEWAY_TASKS=

# ===== 语忆开放平台 =====
YUYIDATA_BASE_URL=https://openapi.yuyidata.com
YUYIDATA_APP_KEY=
YUYIDATA_APP_SECRET=

# ===== 调度 =====
SCHEDULER_TIMEZONE=Asia/Shanghai

# ===== Redis缓存 =====
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_DEFAULT=60
CACHE_TTL_DASHBOARD=120
CACHE_TTL_SKILL_LIST=30
CACHE_TTL_COMPLIANCE=300
CACHE_TTL_EXECUTION=30
CACHE_TTL_PLAYBOOK=120
CACHE_TTL_DATASOURCE=120
CACHE_TTL_AUDIT=300
CACHE_TTL_REVIEW=30
TASKTREE_TOP_LEVEL_PARENT_ID=
TASKTREE_SHOW_VIRTUAL_GROUPS=true

# ===== 训练控制面（节点需先注册；默认不自动审核／部署）=====
TRAINING_AUTOMATION_ENABLED=false
LEARNING_AUTO_TRAINING_ENABLED=false
LEARNING_AUTO_TRAINING_DISPATCH_ENABLED=false
LEARNING_AUTO_DEPLOYMENT_APPROVE_ENABLED=false
TRAINING_MODEL_TRANSFER_HOSTS={}
MEDIA_RECIPE_FILE=

# 系统服务注册为显式部署操作，普通启动不修改 systemd
SKILLFORGE_SERVICE_AUTOREGISTER=0
